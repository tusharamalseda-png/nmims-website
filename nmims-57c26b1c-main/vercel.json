{
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "nmims-website.vercel.app"
        }
      ],
      "destination": "https://rh-academy-website.vercel.app/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "nmims-website.vercel.app"
        }
      ],
      "destination": "https://rh-academy-website.vercel.app/:path*",
      "permanent": true
    }
  ]
}
